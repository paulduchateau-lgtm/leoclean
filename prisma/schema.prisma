// ---------------------------------------------------------------------------
// LéoClean — schéma de données
//
// Deux principes gouvernent ce schéma.
//
// 1. Multi-tenant strict. Toute table métier porte `organizationId`. Le
//    cloisonnement n'est pas laissé à la vigilance de l'appelant : l'extension
//    Prisma de `src/lib/db.ts` dérive la liste des modèles concernés du DMMF et
//    injecte le filtre elle-même. Un modèle métier ajouté sans `organizationId`
//    fait échouer un test dédié.
//
// 2. Le temps est stocké en UTC, l'argent en centimes entiers. Aucun flottant
//    ne représente un montant. Les heures locales de récurrence sont stockées
//    en minutes depuis minuit, dans le fuseau d'affichage Europe/Paris, parce
//    qu'un ménage « le mardi à 9 h » reste à 9 h de part et d'autre du
//    changement d'heure.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Organisation et identités
// ===========================================================================

enum OrganizationType {
  /// LéoClean elle-même. Une seule instance : la marketplace d'indépendants.
  MARKETPLACE
  /// Société de ménage locale, cliente du SaaS, avec ses propres salariés.
  COMPANY
  /// Intervenant indépendant disposant de sa propre page de réservation.
  INDEPENDENT
}

/// Nature juridique de la prestation.
///
/// PRESTATAIRE : l'organisation vend la prestation et en porte la
/// responsabilité. MANDATAIRE : l'organisation met en relation, le client
/// devient l'employeur (CESU). Ce n'est pas une variante d'affichage — c'est un
/// autre contrat, une autre facturation et une autre responsabilité juridique.
/// Modélisé dès maintenant, non implémenté tant que le cadre n'est pas validé.
enum EngagementMode {
  /// L'organisation vend la prestation et en porte la responsabilité.
  /// C'est le mode des sociétés de ménage clientes du SaaS.
  PRESTATAIRE
  /// La plateforme met en relation ; l'intervenant vend sa prestation pour son
  /// propre compte et la facture lui-même. LéoClean n'est pas chargée de la
  /// réalisation et facture séparément sa coordination. C'est le mode de la
  /// marketplace, conformément aux CGU.
  MISE_EN_RELATION
  /// Le client devient l'employeur (CESU), l'organisation gère le placement et
  /// les formalités. Autre contrat, autre facturation, autre responsabilité
  /// juridique. Modélisé, non implémenté.
  MANDATAIRE
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Organization {
  id     String             @id @default(cuid())
  /// Segment de `/pro/[slug]`. Indexable, donc stable dans le temps.
  slug   String             @unique
  name   String
  type   OrganizationType
  status OrganizationStatus @default(PENDING)

  engagementMode EngagementMode @default(PRESTATAIRE)

  /// Commission par défaut, en points de base (2500 = 25 %). Recopiée et figée
  /// sur chaque réservation à sa création.
  commissionRateBp Int @default(2500)

  /// Contenu de la page publique de réservation.
  isPubliclyBookable Boolean @default(false)
  tagline            String?
  description        String?
  logoUrl            String?
  publicPhone        String?
  publicEmail        String?

  /// Identifiants légaux, vérifiés avant activation.
  legalName            String?
  siret                String?
  /// Numéro de déclaration Services à la personne, requis pour communiquer
  /// sur le crédit d'impôt.
  sapDeclarationNumber String?
  insuranceExpiresAt   DateTime?

  /// Stripe. `stripeAccountId` est le compte Connect qui reçoit les
  /// reversements ; `stripeCustomerId` porte l'abonnement SaaS des sociétés.
  stripeAccountId    String?
  stripeCustomerId   String?
  subscriptionPlan   String?
  subscriptionStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  clientProfiles         ClientProfile[]
  cleanerProfiles        CleanerProfile[]
  addresses              Address[]
  services               Service[]
  serviceOptions         ServiceOption[]
  pricingRules           PricingRule[]
  bookings               Booking[]
  bookingItems           BookingItem[]
  bookingStatusEvents    BookingStatusEvent[]
  subscriptions          Subscription[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  calendarConnections    CalendarConnection[]
  externalBusyBlocks     ExternalBusyBlock[]
  assignments            Assignment[]
  slotProposals          SlotProposal[]
  payments               Payment[]
  payouts                Payout[]
  invoices               Invoice[]
  reviews                Review[]
  messages               Message[]
  cleanerDocuments       CleanerDocument[]
  leads                  Lead[]
  auditLogs              AuditLog[]
  referralCodes          ReferralCode[]
  referrals              Referral[]
  referralRewards        ReferralReward[]
  analyticsEvents        AnalyticsEvent[]
  pricingSurcharges      PricingSurcharge[]
  propertyKeyLogs        PropertyKeyLog[]
  accessSecretReads      AccessSecretRead[]
  missionChecks          MissionCheck[]
  missionPhotos          MissionPhoto[]
  missionAnomalies       MissionAnomaly[]
  missionChecklistItems  MissionChecklistItem[]

  @@index([type, status])
}

enum Role {
  /// Administrateur LéoClean. Seul rôle autorisé à franchir la frontière
  /// d'organisation, et uniquement via un chemin explicite et journalisé.
  PLATFORM_ADMIN
  ORG_OWNER
  ORG_MANAGER
  CLEANER
  CLIENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// Identité globale. Un utilisateur n'est pas cloisonné : une même personne
/// peut être cliente de la marketplace et d'une société, ou cliente ici et
/// intervenante là. Le cloisonnement porte sur les appartenances et les
/// profils, pas sur le compte.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  clientProfiles    ClientProfile[]
  cleanerProfiles   CleanerProfile[]
  auditLogs         AuditLog[]
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageRecipient")
  verifiedDocuments CleanerDocument[] @relation("DocumentVerifier")
  referralCodes     ReferralCode[]
  referredBy        Referral?
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)

  invitedAt  DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Une personne n'occupe qu'un rôle par organisation.
  @@unique([userId, organizationId])
  @@index([organizationId, role, status])
}

// --- Auth.js ---------------------------------------------------------------
// Tables imposées par l'adaptateur Auth.js. Volontairement hors périmètre
// multi-tenant : elles portent l'authentification, pas des données métier.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================================================
// Profils
// ===========================================================================

model ClientProfile {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  phone String?

  /// Consignes d'accès au logement : code de porte, emplacement des clés,
  /// présence d'animaux. Données sensibles, jamais exposées hors de
  /// l'organisation ni à un intervenant non affecté.
  accessNotes String?

  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses     Address[]
  bookings      Booking[]
  subscriptions Subscription[]
  reviews       Review[]

  @@unique([organizationId, userId])
  @@index([organizationId])
}

enum CleanerStatus {
  /// Inscrit, documents non encore validés. Ne reçoit aucune mission.
  PENDING_VERIFICATION
  ACTIVE
  /// Suspendu par la plateforme, ou congé longue durée.
  SUSPENDED
  INACTIVE
}

enum EmploymentType {
  /// Auto-entrepreneur : facture sa prestation, reçoit un reversement Connect.
  INDEPENDENT
  /// Salarié d'une société cliente du SaaS : payé par son employeur.
  EMPLOYEE
}

model CleanerProfile {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// Prénom affiché au client. On ne publie jamais le nom complet.
  displayName    String
  bio            String?
  photoUrl       String?
  status         CleanerStatus  @default(PENDING_VERIFICATION)
  employmentType EmploymentType @default(INDEPENDENT)

  siret                String?
  /// Numéro de déclaration Services à la personne de l'intervenant.
  ///
  /// La facturation en deux lignes suppose **deux** organismes déclarés : celui
  /// de Léo Clean pour sa coordination, celui de l'intervenant pour le ménage.
  /// Sans ce numéro, la part de l'intervenant n'ouvre aucun crédit d'impôt au
  /// client, et la promesse faite en page tarifs ne tient qu'à moitié.
  ///
  /// Il s'écrit « SAP » suivi du SIREN, ce qui autorise un recoupement avec le
  /// SIRET déclaré : deux identités différentes sont soit une faute de frappe,
  /// soit le numéro de quelqu'un d'autre.
  sapDeclarationNumber String?
  insuranceExpiresAt   DateTime?
  stripeAccountId      String?
  /// Onboarding Stripe Connect achevé : sans cela, aucun reversement possible.
  payoutsEnabled       Boolean   @default(false)

  /// Point de départ et d'arrivée de la tournée quotidienne.
  homeAddressId String? @unique

  /// Temps de trajet maximal accepté depuis la mission précédente, en minutes.
  maxTravelMinutes Int @default(30)

  /// Agrégats dénormalisés, recalculés à la clôture d'une mission. Ils servent
  /// au score d'attribution et à l'affichage ; la vérité reste dans Review et
  /// Assignment.
  ratingAverage  Float @default(0)
  ratingCount    Int   @default(0)
  acceptanceRate Float @default(1)

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeAddress               Address?                @relation("CleanerHome", fields: [homeAddressId], references: [id], onDelete: SetNull)
  documents                 CleanerDocument[]
  availabilityRules         AvailabilityRule[]
  availabilityExceptions    AvailabilityException[]
  calendarConnections       CalendarConnection[]
  externalBusyBlocks        ExternalBusyBlock[]
  assignments               Assignment[]
  slotProposals             SlotProposal[]
  payouts                   Payout[]
  reviews                   Review[]
  issuedInvoices            Invoice[]
  preferredForSubscriptions Subscription[]          @relation("PreferredCleaner")
  propertyKeyLogs           PropertyKeyLog[]
  accessSecretReads         AccessSecretRead[]
  missionChecks             MissionCheck[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

enum DocumentType {
  SIRET
  INSURANCE_RC_PRO
  IDENTITY
  BANK_DETAILS
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Pièces justificatives exigées avant activation d'un intervenant : SIRET
/// actif, attestation de responsabilité civile professionnelle, pièce
/// d'identité, RIB.
model CleanerDocument {
  id               String         @id @default(cuid())
  organizationId   String
  cleanerProfileId String
  type             DocumentType
  status           DocumentStatus @default(PENDING)

  fileUrl         String
  expiresAt       DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)
  verifiedBy   User?          @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([cleanerProfileId, type])
  @@index([organizationId, status])
}

// ===========================================================================
// Adresses et géographie
// ===========================================================================

/// Adresse géocodée.
///
/// Le géocodage passe par la Base Adresse Nationale (api-adresse.data.gouv.fr).
/// `inseeCode` est l'identifiant de résolution de la commune : trois communes
/// de la zone partagent le code postal 33640 et six le 33650, et les noms sont
/// saisis de façon inconstante par les clients.
///
/// La colonne `geog` est une colonne générée PostGIS (voir la migration
/// initiale) : elle est dérivée de `lat`/`lng`, ne peut pas diverger, et porte
/// l'index GIST utilisé par les requêtes de proximité.
model Address {
  id              String  @id @default(cuid())
  organizationId  String
  clientProfileId String?

  label      String?
  street     String
  complement String?
  postalCode String
  cityName   String
  inseeCode  String

  lat Float
  lng Float

  /// Identifiant de l'adresse dans la Base Adresse Nationale, quand la saisie
  /// a été résolue automatiquement.
  banId String?

  /// Informations d'accès non sensibles : étage, ascenseur, stationnement.
  /// Le digicode, lui, ne passe pas par ici — voir `accessSecretEnc`.
  accessNotes String?
  floor       String?
  hasElevator Boolean?

  // --- Le logement, et non plus seulement le point postal -------------------

  /// `APPARTEMENT` · `MAISON`
  propertyType String?
  rooms        Int?
  bathrooms    Int?
  wc           Int?
  parkingNotes String?

  /// Ce à quoi on ne touche pas. Écrit par le client, lu par l'intervenant.
  forbiddenZones   String?
  /// Animaux : nom, tempérament, consigne. Un chien qu'on ne sait pas nommer
  /// est un chien qu'on n'ose pas approcher.
  pets             Json?
  /// Allergies et produits à éviter. Sécurité avant confort.
  allergies        String?
  /// Matériel disponible sur place : aspirateur, serpillère, produits.
  supplies         Json?
  /// Le client fournit ses produits, ou l'intervenant apporte les siens.
  ownProducts      Boolean?
  /// Tâches habituelles par pièce, reprises à chaque passage.
  defaultChecklist Json?

  /// Consigne d'accès sensible — digicode, emplacement d'une clé.
  ///
  /// Chiffrée en AES-256-GCM, jamais lisible par une requête ordinaire, jamais
  /// écrite dans un journal. Elle ne se déchiffre que par
  /// `logement/secret.ts`, pour un intervenant affecté et dans la fenêtre
  /// J-24 h → J+2 h. Hors de cette fenêtre, un compte compromis ne donne accès
  /// à aucun domicile.
  accessSecretEnc   Bytes?
  /// Instant de la dernière modification, pour dire « code enregistré · le … »
  /// au client sans jamais le lui réafficher.
  accessSecretSetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProfile  ClientProfile?     @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  cleanerHome    CleanerProfile?    @relation("CleanerHome")
  bookings       Booking[]
  subscriptions  Subscription[]
  keyLogs        PropertyKeyLog[]
  secretAccesses AccessSecretRead[]

  @@index([organizationId])
  @@index([inseeCode])
}

/// Journal de remise de clés.
///
/// Sans lui, une clé perdue est une discussion sans pièce. Chaque mouvement est
/// horodaté et porte l'accord des deux parties : ce n'est pas une formalité,
/// c'est ce qui permet de dire qui détenait quoi et depuis quand.
model PropertyKeyLog {
  id               String  @id @default(cuid())
  organizationId   String
  addressId        String
  cleanerProfileId String?

  /// `HANDED_OVER` · `RETURNED` · `LOST`
  action String
  notes  String?

  /// Confirmé par le client, et par l'intervenant. Les deux, ou aucun des deux
  /// ne vaut preuve.
  confirmedByClientAt  DateTime?
  confirmedByCleanerAt DateTime?

  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address      Address         @relation(fields: [addressId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile? @relation(fields: [cleanerProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, addressId, createdAt])
}

/// Journal des lectures de consigne d'accès.
///
/// Obligation RGPD, et protection en cas de litige : le jour où un client
/// signale une entrée qu'il n'attendait pas, la question « qui a lu le code, et
/// quand » doit avoir une réponse. Le journal est écrit par le module qui
/// déchiffre, jamais par l'appelant — sinon il finirait par être oublié.
model AccessSecretRead {
  id               String  @id @default(cuid())
  organizationId   String
  addressId        String
  cleanerProfileId String?
  bookingId        String?

  /// Lecture refusée : hors fenêtre, ou sans affectation. Conservée aussi, et
  /// c'est le plus intéressant à relire.
  granted Boolean

  reason String?

  readAt DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address      Address         @relation(fields: [addressId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile? @relation(fields: [cleanerProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, addressId, readAt])
  @@index([cleanerProfileId, readAt])
}

// ===========================================================================
// Catalogue et tarification
// ===========================================================================

enum ServiceKind {
  MENAGE_REGULIER
  GRAND_MENAGE
  REPASSAGE
  VITRES
  FIN_DE_BAIL
}

model Service {
  id             String      @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  kind           ServiceKind
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)

  /// Paramètres d'estimation de durée : surface traitée par heure et plancher
  /// de facturation. Le client peut ajuster la durée proposée.
  sqmPerHour         Int @default(25)
  minDurationMinutes Int @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  options       ServiceOption[]
  pricingRules  PricingRule[]
  bookings      Booking[]
  subscriptions Subscription[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

/// Option facturée en supplément : repassage, vitres, four, réfrigérateur.
/// Une option ajoute une durée et, éventuellement, un montant forfaitaire.
model ServiceOption {
  id             String  @id @default(cuid())
  organizationId String
  serviceId      String
  slug           String
  name           String
  description    String?

  extraMinutes    Int     @default(30)
  extraPriceCents Int     @default(0)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([serviceId, isActive])
}

enum Frequency {
  ONE_OFF
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Tarif horaire applicable à un service pour une fréquence donnée.
///
/// L'historisation par `validFrom`/`validUntil` permet de changer les tarifs
/// sans réécrire le passé : une réservation conserve de toute façon le tarif
/// figé au moment de sa création.
model PricingRule {
  id             String    @id @default(cuid())
  organizationId String
  serviceId      String
  frequency      Frequency

  hourlyRateCents Int

  /// Ce que perçoit l'intervenant, par heure.
  ///
  /// Grandeur primaire de la répartition : la coordination est ce qui reste.
  /// C'est la traduction en base du modèle juridique — une rémunération
  /// proposée et acceptée avant la mission, jamais un pourcentage appliqué
  /// après coup. Elle vit sur la règle et non sur l'organisation, la marge
  /// n'étant pas la même en régulier et en ponctuel : 5 € de l'heure contre 9 €.
  professionalHourlyRateCents Int

  /// Taux du crédit d'impôt services à la personne, en points de base.
  taxCreditRateBp Int @default(5000)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceId, frequency, validFrom])
}

// ===========================================================================
// Réservations
// ===========================================================================

enum BookingStatus {
  DRAFT
  PENDING_ASSIGNMENT
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_CLEANER
  NO_SHOW
  DISPUTED
}

enum BookingSource {
  /// Tunnel de réservation LéoClean.
  LEOCLEAN
  /// Page publique d'une organisation, /pro/[slug].
  ORG_PAGE
  /// Saisie manuelle par une société pour son propre client.
  BACK_OFFICE
}

model Booking {
  id              String  @id @default(cuid())
  organizationId  String
  clientProfileId String
  addressId       String
  serviceId       String
  subscriptionId  String?

  status BookingStatus @default(DRAFT)
  source BookingSource @default(LEOCLEAN)

  /// Instants en UTC. L'affichage en Europe/Paris est une préoccupation de
  /// présentation, jamais de stockage.
  scheduledStart  DateTime
  scheduledEnd    DateTime
  durationMinutes Int

  surfaceSqm     Int?
  frequency      Frequency      @default(ONE_OFF)
  engagementMode EngagementMode @default(PRESTATAIRE)

  /// Montants figés à la création. Un changement de tarif ou de commission ne
  /// réécrit jamais une réservation existante.
  hourlyRateCents Int

  /// Total réglé par le client, somme des deux lignes ci-dessous.
  grossAmountCents Int

  /// Décomposition en deux factures distinctes, émises par deux entités.
  ///
  /// En mise en relation, l'intervenant vend sa prestation pour son propre
  /// compte et la facture ; la plateforme facture séparément sa coordination.
  /// Ce n'est pas une présentation : c'est ce qui évite que la plateforme
  /// devienne prestataire au sens de l'article L7232-6, c'est ce qui permet
  /// aux deux lignes d'ouvrir droit au crédit d'impôt, et c'est ce qui évite
  /// de gonfler artificiellement le chiffre d'affaires de l'intervenant au
  /// regard du plafond de la micro-entreprise.
  ///
  /// `professionalAmountCents` est le montant que l'intervenant a accepté
  /// avant de prendre la mission : c'est une rémunération proposée, pas un
  /// pourcentage appliqué après coup.
  professionalAmountCents Int
  platformFeeAmountCents  Int
  /// Taux effectif de la marge plateforme au moment de la réservation, figé
  /// pour l'audit. Il découle des deux montants ci-dessus.
  commissionRateBp        Int

  /// Crédit d'impôt services à la personne, calculé sur le total des deux
  /// lignes. Il est stocké en toutes circonstances, mais n'est affiché que si
  /// la déclaration SAP a été obtenue.
  taxCreditRateBp      Int @default(5000)
  taxCreditAmountCents Int
  netAmountCents       Int

  cancellationFeeCents Int @default(0)

  /// Lot de diffusion en cours, et instant de son émission.
  ///
  /// Le second lot n'est pas émis à la suite du premier : quand des horaires
  /// alternatifs ont été proposés, on rend la main au client et l'émission
  /// attend sa décision. L'instant d'émission est donc distinct de celui de la
  /// demande, et c'est lui qui datte l'échéance du lot.
  diffusionLot       Int       @default(1)
  diffusionLotSentAt DateTime?

  /// Échéance du lot en cours.
  ///
  /// **Dérivée**, jamais décidée ici : `echeanceDuLot` en est la seule règle.
  /// Elle est écrite en colonne pour que l'ordonnanceur trouve les demandes
  /// échues par un index au lieu de relire toutes les réservations ouvertes.
  /// Une valeur recalculée à chaque écriture ne peut pas diverger de la règle ;
  /// une requête qui balaierait la table, si.
  diffusionDeadlineAt DateTime?

  clientNotes   String?
  internalNotes String?

  cancelledAt        DateTime?
  cancellationReason String?
  completedAt        DateTime?

  /// Durée réellement passée, du pointage d'arrivée à celui de départ.
  ///
  /// **Elle ne refacture rien.** Le montant reste celui qui a été annoncé ; un
  /// ajustement passe par une anomalie validée. Facturer autre chose que ce qui
  /// a été affiché serait un changement de contrat, pas une correction.
  actualMinutes Int?

  /// Rapport jugé complet : deux photos avant et deux après.
  ///
  /// Faux ne bloque rien — ni le check-out, ni le paiement. Un intervenant qui
  /// ne peut pas terminer sa journée à cause d'une photo manquante finit par
  /// photographier n'importe quoi.
  reportComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProfile  ClientProfile          @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  address        Address                @relation(fields: [addressId], references: [id])
  service        Service                @relation(fields: [serviceId], references: [id])
  subscription   Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items          BookingItem[]
  assignments    Assignment[]
  slotProposals  SlotProposal[]
  statusEvents   BookingStatusEvent[]
  payments       Payment[]
  invoices       Invoice[]
  messages       Message[]
  review         Review?
  checks         MissionCheck[]
  photos         MissionPhoto[]
  anomalies      MissionAnomaly[]
  checklistItems MissionChecklistItem[]

  @@index([organizationId, status, scheduledStart])
  @@index([organizationId, clientProfileId])
  @@index([scheduledStart])
  /// L'ordonnanceur cherche « ce qui est échu », toutes organisations
  /// confondues : l'index porte donc l'échéance en tête.
  @@index([diffusionDeadlineAt, status])
}

enum BookingItemKind {
  SERVICE
  OPTION
  /// Majoration de jour ou de délai. Détaillée en ligne plutôt que fondue dans
  /// le total : un client qui lit « dimanche +25 % » comprend, un client qui
  /// voit un montant plus élevé sans explication conteste.
  SURCHARGE
}

/// Ligne de réservation : instantané du catalogue au moment de la commande.
/// Le libellé et le prix sont recopiés, de sorte qu'une modification ultérieure
/// du catalogue ne change pas ce que le client a acheté.
model BookingItem {
  id             String          @id @default(cuid())
  organizationId String
  bookingId      String
  kind           BookingItemKind

  /// Référence au catalogue, conservée à titre indicatif : le libellé et le
  /// prix ci-dessous font foi.
  sourceId String?

  label          String
  quantity       Int    @default(1)
  unitPriceCents Int
  extraMinutes   Int    @default(0)
  totalCents     Int

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// Journal des transitions de statut. Alimente les indicateurs (taux
/// d'annulation, délai d'attribution) et sert de preuve en cas de litige.
model BookingStatusEvent {
  id             String         @id @default(cuid())
  organizationId String
  bookingId      String
  fromStatus     BookingStatus?
  toStatus       BookingStatus
  reason         String?
  actorUserId    String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Ménage récurrent — le cas nominal, pas une option.
///
/// La récurrence est décrite explicitement (fréquence, jour, heure locale)
/// plutôt que par une RRULE : les quatre cas du produit s'expriment sans
/// ambiguïté et restent lisibles en base. `anchorDate` fixe la parité des
/// quinzaines ; `weekOfMonth` la semaine de référence des mensuels.
///
/// `preferredCleanerId` porte l'intervenant attitré : c'est lui que le moteur
/// d'attribution privilégie absolument, et tout remplacement doit être notifié
/// au client.
model Subscription {
  id              String @id @default(cuid())
  organizationId  String
  clientProfileId String
  addressId       String
  serviceId       String

  frequency       Frequency
  /// 1 = lundi … 7 = dimanche (ISO 8601).
  weekday         Int
  /// Heure de début en minutes depuis minuit, fuseau Europe/Paris.
  startMinute     Int
  durationMinutes Int
  /// Pour les mensuels : 1 à 4, ou -1 pour la dernière semaine du mois.
  weekOfMonth     Int?
  anchorDate      DateTime

  preferredCleanerId String?
  status             SubscriptionStatus @default(ACTIVE)
  pausedUntil        DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProfile    ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  address          Address         @relation(fields: [addressId], references: [id])
  service          Service         @relation(fields: [serviceId], references: [id])
  preferredCleaner CleanerProfile? @relation("PreferredCleaner", fields: [preferredCleanerId], references: [id], onDelete: SetNull)
  bookings         Booking[]
  invoices         Invoice[]

  @@index([organizationId, status])
}

// ===========================================================================
// Disponibilité et agenda externe
// ===========================================================================

/// Disponibilité déclarée par l'intervenant, récurrente à la semaine.
/// Les minutes sont comptées depuis minuit dans le fuseau Europe/Paris : un
/// intervenant disponible « le mardi de 9 h à 17 h » le reste de part et
/// d'autre du changement d'heure.
model AvailabilityRule {
  id               String @id @default(cuid())
  organizationId   String
  cleanerProfileId String

  /// 1 = lundi … 7 = dimanche (ISO 8601).
  weekday     Int
  startMinute Int
  endMinute   Int

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([cleanerProfileId, weekday])
}

enum AvailabilityExceptionType {
  /// Congé, absence : retire de la disponibilité.
  UNAVAILABLE
  /// Ouverture ponctuelle hors des règles habituelles.
  AVAILABLE
}

model AvailabilityException {
  id               String                    @id @default(cuid())
  organizationId   String
  cleanerProfileId String
  type             AvailabilityExceptionType

  startAt DateTime
  endAt   DateTime
  reason  String?

  createdAt DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([cleanerProfileId, startAt, endAt])
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
  /// Flux iCal ou CalDAV en lecture seule.
  ICAL
}

enum CalendarConnectionStatus {
  HEALTHY
  /// Jeton expiré ou révoqué : l'intervenant doit réautoriser.
  NEEDS_RECONSENT
  /// Échecs répétés côté fournisseur.
  ERROR
  REVOKED
}

/// Connexion à l'agenda personnel d'un intervenant.
///
/// Les jetons sont chiffrés au repos par la couche applicative. La
/// synchronisation est incrémentale (`syncToken` pour Google, `deltaLink` pour
/// Microsoft) et déclenchée par notification push ; le polling n'est qu'un
/// repli, avec backoff.
///
/// `status` est exposé à l'intervenant comme à l'administrateur : une connexion
/// silencieusement rompue produirait des créneaux vendus sur des heures
/// occupées.
model CalendarConnection {
  id               String                   @id @default(cuid())
  organizationId   String
  cleanerProfileId String
  provider         CalendarProvider
  status           CalendarConnectionStatus @default(HEALTHY)

  /// Compte externe connecté, affiché à l'intervenant pour qu'il sache quel
  /// agenda est lié.
  externalAccountEmail String?
  externalCalendarId   String?

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  /// Curseur de synchronisation incrémentale, propre au fournisseur.
  syncCursor String?

  /// Abonnement aux notifications push. Expire et doit être renouvelé.
  pushChannelId  String?
  pushResourceId String?
  pushExpiresAt  DateTime?

  /// Écriture des missions LéoClean dans l'agenda de l'intervenant.
  writeEnabled Boolean @default(true)

  lastSyncAt          DateTime?
  lastErrorAt         DateTime?
  lastErrorMessage    String?
  consecutiveFailures Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile      @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)
  busyBlocks   ExternalBusyBlock[]

  @@unique([cleanerProfileId, provider, externalCalendarId])
  @@index([organizationId, status])
  @@index([pushExpiresAt])
}

/// Plage occupée importée d'un agenda externe.
///
/// Minimisation RGPD : on n'enregistre que le fait qu'une plage est occupée.
/// Ni titre, ni description, ni participants, ni lieu. L'identifiant externe
/// n'est conservé que pour appliquer les mises à jour et les suppressions.
model ExternalBusyBlock {
  id                   String @id @default(cuid())
  organizationId       String
  cleanerProfileId     String
  calendarConnectionId String

  startAt  DateTime
  endAt    DateTime
  isAllDay Boolean  @default(false)

  externalEventId  String
  /// Événement maître d'une série récurrente, pour traiter les exceptions.
  recurringEventId String?
  sourceUpdatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile     @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)
  connection   CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)

  @@unique([calendarConnectionId, externalEventId])
  @@index([cleanerProfileId, startAt, endAt])
}

// ===========================================================================
// Attribution
// ===========================================================================

enum AssignmentStatus {
  /// Proposée à l'intervenant, en attente de réponse sous délai.
  PROPOSED
  ACCEPTED
  DECLINED
  /// Délai de réponse dépassé : réattribution automatique.
  EXPIRED
  /// Un autre intervenant du lot a accepté le premier. Ce n'est ni un refus,
  /// qui pèserait sur son taux d'acceptation, ni une annulation, qui laisserait
  /// croire à une décision de la plateforme : c'est une course perdue.
  SUPERSEDED
  CANCELLED
  COMPLETED
}

/// Affectation d'un intervenant à une réservation.
///
/// `blockStartAt`/`blockEndAt` étendent le créneau des tampons de trajet. La
/// contrainte d'exclusion posée sur cet intervalle (voir la migration
/// initiale) est le verrou anti-double-réservation : il vit dans la base, pas
/// dans le code applicatif, et prend en compte le temps de route.
model Assignment {
  id               String           @id @default(cuid())
  organizationId   String
  bookingId        String
  cleanerProfileId String
  status           AssignmentStatus @default(PROPOSED)

  /// Lot de diffusion dont cette proposition est issue : 1 pour les mieux
  /// classés sollicités d'emblée, 2 pour l'élargissement au secteur. Conservé
  /// parce qu'il explique pourquoi telle personne a été sollicitée, et qu'une
  /// diffusion qu'on ne peut pas relire est une décision qu'on ne peut pas
  /// défendre.
  lot Int @default(1)

  /// Créneau de la mission, recopié depuis la réservation pour que la
  /// contrainte d'exclusion puisse s'appliquer sans jointure.
  startAt      DateTime
  endAt        DateTime
  /// Créneau élargi des temps de trajet amont et aval.
  blockStartAt DateTime
  blockEndAt   DateTime

  travelMinutesBefore Int @default(0)
  travelMinutesAfter  Int @default(0)

  /// Décomposition du score d'attribution : coût d'insertion trajet, note,
  /// taux d'acceptation, équité de charge, priorité au cleaner attitré.
  /// Conservée pour pouvoir expliquer une décision.
  score          Float?
  scoreBreakdown Json?

  proposedAt    DateTime  @default(now())
  respondBy     DateTime?
  respondedAt   DateTime?
  declineReason String?

  /// Renseigné quand cette affectation remplace un intervenant absent.
  isReplacement        Boolean @default(false)
  replacedAssignmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([cleanerProfileId, startAt])
  @@index([bookingId, status])
  @@index([respondBy])
}

enum SlotProposalStatus {
  /// Proposée par l'intervenant, en attente de la réponse du client.
  PENDING
  /// Le client a validé : la réservation est déplacée et l'affectation créée.
  ACCEPTED
  DECLINED
  /// L'intervenant s'est rétracté avant la réponse du client.
  WITHDRAWN
  /// Le client n'a pas répondu à temps, ou l'heure proposée est passée.
  EXPIRED
}

/// Créneau de remplacement proposé par un intervenant.
///
/// Elle n'existe que dans un cas : personne n'a accepté la mission à l'heure
/// demandée, et la réservation est retombée en `PENDING_ASSIGNMENT`. Plutôt
/// que de laisser le client attendre un appel, un intervenant qui voudrait la
/// prendre à une autre heure le propose, et le client tranche.
///
/// C'est une **proposition**, pas une modification : rien ne bouge tant que le
/// client n'a pas validé. Cette asymétrie n'est pas une politesse — déplacer
/// unilatéralement le rendez-vous de quelqu'un serait une rupture de la
/// promesse vendue par le tunnel, qui est un créneau ferme.
///
/// La durée n'est pas renégociable ici : `proposedEnd` se déduit de la durée
/// de la réservation. Un intervenant qui voudrait aussi changer la durée
/// change le prix, et cela se traite au téléphone.
model SlotProposal {
  id               String             @id @default(cuid())
  organizationId   String
  bookingId        String
  cleanerProfileId String
  status           SlotProposalStatus @default(PENDING)

  proposedStart DateTime
  proposedEnd   DateTime

  /// Mot de l'intervenant au client. « Je peux jeudi mais pas mardi. »
  message String?

  /// Au-delà, la proposition ne vaut plus : le planning aura bougé.
  respondBy   DateTime?
  respondedAt DateTime?

  /// Instant à partir duquel le client la voit.
  ///
  /// Une **pré-acceptation** — moins d'une heure d'écart, proposée par quelqu'un
  /// qui tient encore l'offre — part tout de suite : il s'est engagé, faire
  /// attendre le client n'apporterait rien. Une contre-proposition ordinaire
  /// attend l'échéance du lot : le client a demandé une heure, on la cherche
  /// avant de lui en proposer une autre.
  ///
  /// La colonne porte cette différence plutôt qu'un statut, parce que le statut
  /// décrit le cycle de la réponse et non celui de la visibilité — mêler les
  /// deux rendrait « en attente mais pas encore montrée » inexprimable.
  visibleAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  /// Un intervenant ne propose pas deux fois la même heure sur la même
  /// réservation : sans cela, un double envoi produirait deux cartes
  /// identiques à valider, et valider la seconde après la première
  /// déplacerait un rendez-vous déjà déplacé.
  @@unique([bookingId, cleanerProfileId, proposedStart])
  @@index([organizationId, status])
  @@index([bookingId, status])
  @@index([cleanerProfileId, status])
  /// La lecture client cherche « visible, en attente, à venir ».
  @@index([bookingId, status, visibleAt])
}

// ===========================================================================
// Argent
// ===========================================================================

enum PaymentStatus {
  /// Empreinte prise à la réservation, débit différé après la prestation.
  REQUIRES_CAPTURE
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  bookingId      String
  status         PaymentStatus @default(REQUIRES_CAPTURE)

  stripePaymentIntentId String? @unique
  amountCents           Int
  capturedAmountCents   Int     @default(0)
  refundedAmountCents   Int     @default(0)

  authorizedAt DateTime?
  capturedAt   DateTime?
  failureCode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

model Payout {
  id               String       @id @default(cuid())
  organizationId   String
  cleanerProfileId String
  status           PayoutStatus @default(PENDING)

  stripeTransferId String? @unique
  amountCents      Int

  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([cleanerProfileId, periodStart])
}

enum InvoiceType {
  /// Prestation facturée au client par l'intervenant, pour son propre compte.
  CLIENT_SERVICE
  /// Coordination facturée au client par LéoClean.
  ///
  /// Deuxième ligne de la même réservation, émise par une autre entité. Le
  /// client voit donc deux factures, et deux lignes dans son espace URSSAF :
  /// l'avance immédiate fonctionne par demande de paiement déposée par chaque
  /// organisme déclaré, avec son propre SIRET.
  CLIENT_COORDINATION
  /// Abonnement SaaS d'une société cliente de la plateforme.
  ORG_SUBSCRIPTION
}

model Invoice {
  id             String      @id @default(cuid())
  organizationId String
  bookingId      String?
  subscriptionId String?
  type           InvoiceType

  /// Numérotation séquentielle, continue et propre à chaque organisation :
  /// exigence comptable.
  number String

  issuedAt               DateTime @default(now())
  totalCents             Int
  /// Part de la facture ouvrant droit au crédit d'impôt services à la personne.
  taxCreditEligibleCents Int      @default(0)
  pdfUrl                 String?

  createdAt DateTime @default(now())

  /// Émetteur, lorsque la facture est celle d'un intervenant vendant pour son
  /// propre compte. Nul pour les factures émises par l'organisation.
  issuedByCleanerProfileId String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  issuedBy     CleanerProfile? @relation(fields: [issuedByCleanerProfileId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@index([issuedByCleanerProfileId])
}

// ===========================================================================
// Relation client
// ===========================================================================

/// Avis client.
///
/// `communeInsee` est recopié depuis l'adresse de la prestation : les pages
/// locales affichent les avis des clients de la commune concernée, ce qui est
/// à la fois plus utile au lecteur et plus solide en référencement qu'un flux
/// d'avis générique.
model Review {
  id               String @id @default(cuid())
  organizationId   String
  bookingId        String @unique
  clientProfileId  String
  cleanerProfileId String

  rating       Int
  comment      String?
  communeInsee String

  isPublic    Boolean   @default(true)
  publishedAt DateTime?
  reply       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientProfile ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  cleaner       CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, isPublic, publishedAt])
  @@index([communeInsee, isPublic])
  @@index([cleanerProfileId])
}

model Message {
  id              String  @id @default(cuid())
  organizationId  String
  bookingId       String?
  senderUserId    String
  recipientUserId String

  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient    User         @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientUserId, readAt])
  @@index([bookingId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

/// Demande de rappel déposée depuis le site public.
///
/// Le site est mis en ligne avant l'ouverture du tunnel de réservation, afin
/// que l'indexation courre pendant la construction du moteur. Ce formulaire est
/// le point de conversion en attendant.
model Lead {
  id             String     @id @default(cuid())
  organizationId String
  status         LeadStatus @default(NEW)

  name         String
  email        String?
  phone        String
  communeInsee String?
  message      String?
  /// Page d'origine, pour mesurer quelles pages locales convertissent.
  sourcePath   String?

  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
}

// ===========================================================================
// Parrainage et cooptation
// ===========================================================================

enum ReferrerKind {
  CLIENT
  CLEANER
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  EXPIRED
  CANCELLED
}

/// Code de parrainage d'un membre.
///
/// Un code par personne et par organisation. Le code est unique globalement :
/// il circule par SMS et de vive voix, et deux codes identiques dans deux
/// organisations rendraient toute saisie ambiguë.
model ReferralCode {
  id             String       @id @default(cuid())
  organizationId String
  ownerUserId    String
  kind           ReferrerKind
  code           String       @unique
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  referrals    Referral[]

  @@unique([organizationId, ownerUserId, kind])
  @@index([organizationId, isActive])
}

/// Parrainage d'une personne par une autre.
///
/// Un seul niveau : aucune colonne ne rattache un parrainage à un autre, ce
/// qui rend structurellement impossible de rémunérer les filleuls d'un filleul.
/// La contrainte d'unicité sur `refereeUserId` empêche qu'un même compte soit
/// parrainé deux fois — la fraude la plus évidente.
model Referral {
  id             String         @id @default(cuid())
  organizationId String
  referralCodeId String
  refereeUserId  String
  status         ReferralStatus @default(PENDING)

  /// Prestations du filleul terminées et payées, qui conditionnent le
  /// déclenchement. Le gain suit l'activité, jamais le recrutement.
  completedBookings Int @default(0)

  qualifiedAt        DateTime?
  expiresAt          DateTime
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralCode ReferralCode     @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referee      User             @relation(fields: [refereeUserId], references: [id], onDelete: Cascade)
  rewards      ReferralReward[]

  /// Une personne n'est parrainée qu'une fois, définitivement.
  @@unique([refereeUserId])
  @@index([organizationId, status])
  @@index([referralCodeId])
  @@index([expiresAt])
}

enum ReferralRewardKind {
  /// Avoir sur ses propres prestations : remise commerciale, non imposable.
  CREDIT
  /// Versement en espèces : revenu, déclaré par son bénéficiaire.
  CASH
}

enum ReferralRewardStatus {
  PENDING
  PAID
  CANCELLED
}

/// Récompense acquise au titre d'un parrainage.
///
/// Une ligne par versement : une seule pour un parrainage client, une par mois
/// pour la cooptation d'un intervenant. Conserver le détail plutôt qu'un solde
/// permet de répondre à « d'où vient ce montant ? », question qui se pose
/// nécessairement dès le premier litige.
model ReferralReward {
  id             String               @id @default(cuid())
  organizationId String
  referralId     String
  kind           ReferralRewardKind
  status         ReferralRewardStatus @default(PENDING)

  amountCents Int

  /// Mois de rattachement, pour les commissions récurrentes. Nul pour une
  /// récompense unique.
  periodStart          DateTime?
  periodEnd            DateTime?
  /// Chiffre d'affaires du filleul ayant servi de base au calcul.
  basisAmountCents     Int?
  /// Le plafond mensuel a rogné le montant dû.
  cappedByMonthlyLimit Boolean   @default(false)

  paidAt   DateTime?
  /// Reversement Stripe portant cette récompense, pour les versements en
  /// espèces.
  payoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referral     Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)

  /// Une seule commission par parrainage et par mois : garde-fou contre un
  /// double versement en cas de rejeu du traitement mensuel.
  @@unique([referralId, periodStart])
  @@index([organizationId, status])
}

// ===========================================================================
// Infrastructure
// ===========================================================================

/// Cache des temps de trajet.
///
/// Volontairement hors périmètre multi-tenant : un temps de trajet entre deux
/// points est un fait géographique, pas une donnée d'organisation. Le mutualiser
/// est ce qui rend le cache efficace — sur un territoire de 330 km², les mêmes
/// couples d'adresses reviennent constamment.
///
/// Les clés sont des coordonnées arrondies : au-delà de cinq décimales, la
/// précision dépasse celle du réseau routier et fragmente le cache pour rien.
model TravelTimeCache {
  id       String @id @default(cuid())
  provider String

  originKey String
  destKey   String

  originLat Float
  originLng Float
  destLat   Float
  destLng   Float

  durationSeconds Int
  distanceMeters  Int

  computedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@unique([provider, originKey, destKey])
  @@index([expiresAt])
}

/// Journal des webhooks reçus, garant de l'idempotence.
///
/// Stripe comme Google rejouent leurs notifications. L'identifiant externe est
/// unique : un événement déjà traité est ignoré au lieu d'être appliqué deux
/// fois.
model WebhookEvent {
  id         String @id @default(cuid())
  provider   String
  externalId String
  eventType  String
  payload    Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
  @@index([provider, processedAt])
}

/// Journal d'audit. `organizationId` est optionnel : certaines actions sont
/// le fait de la plateforme et ne relèvent d'aucune organisation.
/// Compteur de limitation de débit.
///
/// Le site prend des réservations sans compte : les formulaires publics sont
/// donc la surface la plus exposée, et la seule protection en place — champ
/// piège et délai de trois secondes — n'arrête qu'un robot naïf.
///
/// Le compteur vit en base et non en mémoire, pour la même raison que la
/// limitation d'envoi des liens de connexion : un déploiement sans serveur
/// n'a pas de mémoire partagée, et un compteur par instance ne compte rien.
///
/// `key` porte l'action et la source — adresse IP hachée, ou adresse email.
/// L'IP n'est jamais stockée en clair : c'est une donnée personnelle, et un
/// compteur n'a pas besoin de savoir qui, seulement combien.
model RateLimit {
  id String @id @default(cuid())

  key   String @unique
  count Int    @default(0)

  /// Début de la fenêtre courante. Une fenêtre glissante coûterait une ligne
  /// par requête ; une fenêtre fixe suffit à arrêter un abus.
  windowAt DateTime

  updatedAt DateTime @updatedAt

  @@index([windowAt])
}

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String?
  actorUserId    String?

  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

/// Événement de parcours, enregistré pour comprendre ce qui coûte des clients
/// et des intervenants sans que personne ne se plaigne.
///
/// La mesure vit en base plutôt que chez un tiers, et ce n'est pas une économie :
/// le module Frictions lira la même base que le reste du produit, et une mesure
/// qui ne dépose aucun cookie et ne suit personne d'un site à l'autre n'a pas à
/// demander un consentement qu'on obtiendrait mal.
///
/// **Aucune donnée personnelle n'entre ici.** Ni nom, ni email, ni téléphone, ni
/// adresse, ni position, ni adresse IP : `CHAMPS_INTERDITS` l'impose à
/// l'écriture, et un test l'impose à la définition. Un événement dit ce qui
/// s'est passé, jamais à qui — sans quoi une table de mesure échapperait à la
/// purge des comptes et deviendrait le dernier endroit où une identité survit.
model AnalyticsEvent {
  id             String @id @default(cuid())
  organizationId String

  /// Nom de la taxonomie : objet puis verbe au passé.
  name String

  /// Identifiant de parcours engendré par le navigateur, opaque et sans lien
  /// avec une identité. Il ne sert qu'à relier les écrans d'une même session ;
  /// sans lui, un taux d'abandon par étape n'est pas calculable.
  journeyId String?

  /// Renseigné quand la personne était connectée. Nul le reste du temps, ce qui
  /// est le cas de tout le tunnel jusqu'à l'avant-dernier écran.
  userId String?

  properties Json @default("{}")

  occurredAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// L'analyse lit « tel événement sur telle période » : le nom en tête.
  @@index([organizationId, name, occurredAt])
  @@index([journeyId])
  /// La purge de rétention balaie par date, toutes organisations confondues.
  @@index([occurredAt])
}

/// Majoration de prix, avec son bénéficiaire.
///
/// Le jour — samedi, dimanche, férié — revient à l'intervenant : c'est lui qui
/// travaille le week-end. Le délai — moins de 48 heures — revient à la
/// plateforme : c'est elle qui place la mission au forceps. Ce partage prolonge
/// la règle du dépôt, où la marge est un écart et non un taux.
///
/// Historisée comme `PricingRule` : une réservation passée continue de pointer
/// sur la règle qui l'a chiffrée.
model PricingSurcharge {
  id             String @id @default(cuid())
  organizationId String

  /// `SAMEDI` · `DIMANCHE_FERIE` · `COURT_DELAI`
  cause       String
  rateBp      Int
  /// `PROFESSIONAL` · `PLATFORM`
  beneficiary String
  label       String

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, cause, validFrom])
}

/// Demande venue d'une commune que Léo Clean ne dessert pas.
///
/// Le tunnel rend une réservation hors zone structurellement impossible — on
/// choisit sa commune dans le référentiel — et c'est un bon choix : il n'existe
/// aucun moyen de réserver un ménage qu'on ne saurait pas honorer. Mais la
/// conséquence est que **le produit n'a aucun signal d'expansion** : personne ne
/// sait combien de gens ont voulu réserver depuis Pessac.
///
/// Volontairement hors du périmètre multi-tenant : une demande hors zone
/// précède toute organisation, comme les compteurs de limitation de débit.
model Waitlist {
  id String @id @default(cuid())

  /// `CLIENT` ou `CLEANER` : les deux manques ne se comblent pas pareil.
  kind String

  email String?
  phone String?

  /// Ce que la personne a écrit. Aucune géolocalisation : une commune suffit à
  /// décider d'ouvrir un secteur, un point désigne un domicile.
  communeName String
  postalCode  String?

  /// Page d'origine, pour savoir ce qui amène ces gens.
  sourcePath String?

  /// Prévenue de l'ouverture. Nul tant que personne ne l'a été.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  /// L'analyse lit « combien de demandes par commune, et depuis quand ».
  @@index([kind, communeName, createdAt])
}

/// Pointage d'arrivée ou de départ.
///
/// La position est capturée **au tap seulement**, jamais en continu : c'est une
/// preuve de réalisation, pas une surveillance. Elle n'est jamais bloquante —
/// un sous-sol, un immeuble mal géocodé ou un refus de localisation ne doivent
/// pas empêcher quelqu'un de travailler. Rétention treize mois.
model MissionCheck {
  id               String @id @default(cuid())
  organizationId   String
  bookingId        String
  cleanerProfileId String

  /// `ARRIVEE` ou `DEPART`.
  kind String

  at DateTime @default(now())

  lat            Float?
  lng            Float?
  /// Écart au logement au moment du pointage, en mètres. Conservé même hors
  /// tolérance : c'est ce qui permet de relire une contestation.
  distanceMeters Int?
  /// `POSITION` · `MANUEL` · `CODE_CLIENT` · `HORS_LIGNE`
  method         String

  /// Instant relevé par l'appareil quand le pointage a été fait hors ligne.
  /// C'est lui qui fait foi, et le marquage dit qu'il vient de l'appareil.
  deviceAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner      CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  /// Un seul pointage de chaque sens par mission.
  @@unique([bookingId, kind])
  @@index([organizationId, at])
}

/// Photo de mission, avant ou après.
///
/// Consigne affichée à la prise : cadrer les pièces, jamais les personnes ni
/// les documents. Rétention treize mois, comme les positions.
model MissionPhoto {
  id             String @id @default(cuid())
  organizationId String
  bookingId      String

  /// `AVANT` ou `APRES`.
  phase String
  /// Pièce concernée, telle que l'intervenant l'a nommée.
  room  String?

  /// Chemin dans le coffre `missions/`. Jamais une URL : elles se périment en
  /// soixante secondes et se demandent au moment de l'affichage.
  storagePath String

  takenAt    DateTime?
  uploadedAt DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, phase])
}

/// Anomalie constatée sur place.
///
/// Une seule catégorie peut proposer un ajustement de durée — le logement
/// inhabituellement sale — et **la proposition ne facture rien** : elle attend
/// une validation. Un supplément appliqué unilatéralement par celui qui en
/// bénéficie n'est pas un ajustement, c'est une facture non consentie.
model MissionAnomaly {
  id             String @id @default(cuid())
  organizationId String
  bookingId      String

  type        String
  description String?
  storagePath String?

  /// Minutes proposées en plus. Nul tant que rien n'est proposé.
  proposedExtraMinutes Int?
  /// `PENDING` · `ACCEPTED` · `REFUSED`. Nul quand aucun ajustement n'est demandé.
  adjustmentStatus     String?
  decidedAt            DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, adjustmentStatus])
  @@index([bookingId])
}

/// Tâche de la checklist d'un passage.
///
/// **Ce n'est pas un instrument de contrôle**, c'est un mémo et une preuve.
/// Rien ne bloque au check-out : une confirmation suffit. Les tâches ajoutées
/// par le client pour ce passage se distinguent des tâches habituelles.
model MissionChecklistItem {
  id             String @id @default(cuid())
  organizationId String
  bookingId      String

  room          String?
  label         String
  /// Ajoutée par le client pour ce passage, par opposition aux tâches
  /// habituelles du logement.
  addedByClient Boolean @default(false)

  doneAt DateTime?

  position Int @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, position])
}
