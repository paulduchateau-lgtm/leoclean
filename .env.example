# ---------------------------------------------------------------------------
# LéoClean — configuration
#
# Copier en `.env` puis compléter. Le schéma de référence est `src/lib/env.ts`
# et il est appliqué au démarrage du serveur : une valeur manquante ou mal
# formée fait échouer le boot avec un message explicite.
#
# Les blocs sont annotés par la phase qui les rend nécessaires. Les phases non
# encore atteintes peuvent rester vides.
# ---------------------------------------------------------------------------

# --- Base de données — phase 1 ---------------------------------------------
# PostgreSQL 15+ avec les extensions PostGIS et btree_gist. Neon et Supabase
# les fournissent ; en local : CREATE EXTENSION postgis; CREATE EXTENSION btree_gist;
#
# Les tests d'intégration exigent une base distincte, dont le nom se termine
# par _test : ils tronquent les tables.
DATABASE_URL="postgresql://leoclean:leoclean@localhost:5432/leoclean"
# Connexion directe sans pooler, exigée par `prisma migrate`. Sur Neon/Supabase
# uniquement ; en local, laisser vide.
DIRECT_URL=""

# Sur Supabase, trois pièges, tous silencieux :
#
# 1. `db.<ref>.supabase.co:5432` est la connexion **directe**, joignable en
#    IPv6. Les fonctions serverless sortent en IPv4 : cette URL-là va dans
#    DIRECT_URL, pour les migrations lancées depuis un poste. DATABASE_URL
#    prend l'URL du **pooler**, relevée dans le tableau de bord (bouton
#    « Connect ») — son utilisateur s'écrit `postgres.<ref>`, pas `postgres`.
# 2. PostGIS et btree_gist s'activent dans Database → Extensions **avant** la
#    première migration. PostGIS s'installe alors dans le schéma `extensions` ;
#    `Address.geog` étant une colonne générée, son expression est résolue au
#    moment du CREATE et ne pardonne pas un search_path incomplet.
# 3. Le seed doit être joué une fois : sans organisation de type MARKETPLACE,
#    ni le tunnel ni le formulaire de rappel n'ont d'organisation où écrire.

# --- Authentification — phase 2 --------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Emails transactionnels — phase 2 --------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="bonjour@leoclean.fr"

# --- Site public — phase 4 -------------------------------------------------
# Origine canonique, sans slash final. Alimente canonicals, sitemap et JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Déclaration Services à la personne obtenue auprès de la DDETS.
# Tant que la valeur est "false", aucune mention du crédit d'impôt de 50 %
# n'apparaît sur le site : communiquer sur cet avantage sans être déclaré SAP
# expose à une sanction. Le calcul reste effectué et stocké en base.
NEXT_PUBLIC_SAP_DECLARED="false"

# --- Paiement — phase 7 ----------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Endpoint /api/webhooks/stripe-connect (comptes des intervenants)
STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Jobs asynchrones — phase 8 --------------------------------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Synchronisation d'agenda externe — phase 9 ----------------------------
# Projet Google Cloud, API Calendar activée, scope calendar.events.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
# URL publique HTTPS recevant les notifications push Google.
GOOGLE_CALENDAR_WEBHOOK_URL=""
# Secret partagé vérifiant l'origine des notifications (32 caractères).
GOOGLE_CALENDAR_WEBHOOK_TOKEN=""

# --- Temps de trajet — phase 10 --------------------------------------------
# haversine        : approximation hors ligne, pour les tests et le repli
# openrouteservice : gratuit, 2 000 requêtes/jour, suffisant avec le cache
# osrm             : instance auto-hébergée, sans quota
TRAVEL_TIME_PROVIDER="haversine"
OPENROUTESERVICE_API_KEY=""
OSRM_BASE_URL=""

# --- Divers ----------------------------------------------------------------
# Désactive la validation ci-dessus. Réservé au `next build` en CI et au lint.
# SKIP_ENV_VALIDATION="1"
